<Window x:Class="CenterCoffee.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CenterCoffee.WPF.ViewModels"
        mc:Ignorable="d"
        Title="Центр кофе — панель управления"
        Width="1440"
        Height="900"
        MinWidth="1280"
        MinHeight="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CreamBrush}"
        FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="270" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Боковая панель -->
        <Border Grid.Column="0" Background="{StaticResource EspressoBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="24,26,24,20">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="48"
                                Height="48"
                                Background="#26C98B5E"
                                CornerRadius="14">
                            <TextBlock Text="☕"
                                       FontSize="24"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ЦЕНТР КОФЕ"
                                       Foreground="{StaticResource SidebarTextBrush}"
                                       FontSize="15"
                                       FontWeight="Bold" />
                            <TextBlock Text="ИП Миргородский"
                                       Margin="0,3,0,0"
                                       Foreground="{StaticResource SidebarMutedBrush}"
                                       FontSize="11" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1"
                        Height="1"
                        Margin="24,0"
                        Background="#1FFFFFFF" />

                <StackPanel Grid.Row="2">
                    <TextBlock Margin="26,22,0,8"
                               Foreground="{StaticResource SidebarMutedBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Text="РАЗДЕЛЫ" />

                    <ListBox ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             Style="{StaticResource NavListStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavigationItemViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Icon}"
                                               FontSize="16"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1"
                                               Margin="4,0,8,0"
                                               Text="{Binding Title}"
                                               Foreground="{StaticResource SidebarTextBrush}"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />

                                    <Border Grid.Column="2"
                                            Padding="6,2"
                                            Background="#26C98B5E"
                                            CornerRadius="7"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsInDevelopment, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="скоро"
                                                   Foreground="#F0C7A2"
                                                   FontSize="9"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <Border Grid.Row="3"
                        Margin="16,0,16,18"
                        Padding="14,12"
                        Background="#12FFFFFF"
                        CornerRadius="12">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="34"
                                    Height="34"
                                    Background="{StaticResource CaramelBrush}"
                                    CornerRadius="17">
                                <TextBlock Text="ИП"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ИП Миргородский"
                                           Foreground="{StaticResource SidebarTextBrush}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Кофейня «Центр кофе»"
                                           Margin="0,2,0,0"
                                           Foreground="{StaticResource SidebarMutedBrush}"
                                           FontSize="10" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,12,0,0">
                            <TextBlock Text="Локальное хранилище"
                                       Foreground="{StaticResource SidebarMutedBrush}"
                                       FontSize="10" />
                            <TextBlock Text="{Binding VersionText}"
                                       Foreground="#7F6B5B"
                                       FontSize="10"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Рабочая область -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="34,26,34,18">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding CurrentPage.Title}"
                               FontSize="26"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="{Binding CurrentPage.Subtitle}"
                               Margin="0,5,0,0"
                               FontSize="13"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Margin="0,0,10,0"
                            Padding="12,8"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8"
                                     Height="8"
                                     Fill="{StaticResource SuccessBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Margin="8,0,0,0"
                                       Text="{Binding StorageLabel}"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Padding="12,8"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="10">
                        <TextBlock Text="{Binding TodayText}"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" />
                    </Border>
                </StackPanel>
            </Grid>

            <ContentControl Grid.Row="1"
                            Margin="34,0,34,30"
                            Content="{Binding CurrentPage}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Grid>
    </Grid>
</Window>
