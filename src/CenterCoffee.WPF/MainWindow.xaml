<Window x:Class="CenterCoffee.WPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:CenterCoffee.WPF.ViewModels"
        mc:Ignorable="d"
        Title="Центр кофе — панель управления"
        Width="1180"
        Height="760"
        MinWidth="1120"
        MinHeight="700"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource CreamBrush}"
        FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource TextBrush}"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType"
        UseLayoutRounding="True">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="224" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Боковая панель -->
        <Border Grid.Column="0" Background="{StaticResource EspressoBrush}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Margin="18,18,18,14">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="40"
                                Height="40"
                                Background="#26C98B5E"
                                CornerRadius="12">
                            <TextBlock Text="☕"
                                       FontSize="20"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="ЦЕНТР КОФЕ"
                                       Foreground="{StaticResource SidebarTextBrush}"
                                       FontSize="14"
                                       FontWeight="Bold" />
                            <TextBlock Text="ИП Миргородский"
                                       Margin="0,2,0,0"
                                       Foreground="{StaticResource SidebarMutedBrush}"
                                       FontSize="10" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <Border Grid.Row="1"
                        Height="1"
                        Margin="18,0"
                        Background="#1FFFFFFF" />

                <StackPanel Grid.Row="2">
                    <TextBlock Margin="20,16,0,6"
                               Foreground="{StaticResource SidebarMutedBrush}"
                               FontSize="10"
                               FontWeight="SemiBold"
                               Text="РАЗДЕЛЫ" />

                    <ListBox ItemsSource="{Binding NavigationItems}"
                             SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                             Style="{StaticResource NavListStyle}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:NavigationItemViewModel}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Text="{Binding Icon}"
                                               FontSize="16"
                                               VerticalAlignment="Center" />

                                    <TextBlock Grid.Column="1"
                                               Margin="4,0,8,0"
                                               Text="{Binding Title}"
                                               Foreground="{StaticResource SidebarTextBrush}"
                                               FontSize="13"
                                               TextTrimming="CharacterEllipsis"
                                               VerticalAlignment="Center" />

                                    <Border Grid.Column="2"
                                            Padding="6,2"
                                            Background="#26C98B5E"
                                            CornerRadius="7"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding IsInDevelopment, Converter={StaticResource BoolToVisibility}}">
                                        <TextBlock Text="скоро"
                                                   Foreground="#F0C7A2"
                                                   FontSize="10"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>

                <Border Grid.Row="3"
                        Margin="12,0,12,12"
                        Padding="12,10"
                        Background="#12FFFFFF"
                        CornerRadius="10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Border Width="30"
                                    Height="30"
                                    Background="{StaticResource CaramelBrush}"
                                    CornerRadius="15">
                                <TextBlock Text="ИП"
                                           Foreground="White"
                                           FontSize="10"
                                           FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center" />
                            </Border>
                            <StackPanel Margin="9,0,0,0" VerticalAlignment="Center">
                                <TextBlock Text="ИП Миргородский"
                                           Foreground="{StaticResource SidebarTextBrush}"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                                <TextBlock Text="Кофейня «Центр кофе»"
                                           Margin="0,1,0,0"
                                           Foreground="{StaticResource SidebarMutedBrush}"
                                           FontSize="10" />
                            </StackPanel>
                        </StackPanel>

                        <Grid Margin="0,9,0,0">
                            <TextBlock Text="Локальное хранилище"
                                       Foreground="{StaticResource SidebarMutedBrush}"
                                       FontSize="10" />
                            <TextBlock Text="{Binding VersionText}"
                                       Foreground="{StaticResource SidebarMutedBrush}"
                                       FontSize="10"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Рабочая область -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="24,18,24,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="{Binding CurrentPage.Title}"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="{Binding CurrentPage.Subtitle}"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Margin="0,0,8,0"
                            Padding="10,6"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="7"
                                     Height="7"
                                     Fill="{StaticResource SuccessBrush}"
                                     VerticalAlignment="Center" />
                            <TextBlock Margin="7,0,0,0"
                                       Text="{Binding StorageLabel}"
                                       FontSize="11"
                                       Foreground="{StaticResource MutedBrush}" />
                        </StackPanel>
                    </Border>

                    <Border Padding="10,6"
                            Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="9">
                        <TextBlock Text="{Binding TodayText}"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}" />
                    </Border>
                </StackPanel>
            </Grid>

            <ContentControl Grid.Row="1"
                            Margin="24,0,24,20"
                            Content="{Binding CurrentPage}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />
        </Grid>
    </Grid>
</Window>
