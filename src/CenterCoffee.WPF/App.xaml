<Application x:Class="CenterCoffee.WPF.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:CenterCoffee.WPF.ViewModels"
             xmlns:views="clr-namespace:CenterCoffee.WPF.Views"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Theme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <DataTemplate DataType="{x:Type vm:WarehouseViewModel}">
                <views:WarehouseView />
            </DataTemplate>

            <DataTemplate DataType="{x:Type vm:ComingSoonViewModel}">
                <views:ComingSoonView />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
