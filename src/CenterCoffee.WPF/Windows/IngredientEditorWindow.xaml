<Window x:Class="CenterCoffee.WPF.Windows.IngredientEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="540"
        Height="660"
        Background="{StaticResource CreamBrush}"
        FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding Title}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0,5,0,0"
                       Text="{Binding Subtitle}"
                       FontSize="13"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,22,0,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,4,0">
                <TextBlock Style="{StaticResource FieldLabel}" Text="Название" />
                <TextBox MaxLength="80"
                         AutomationProperties.AutomationId="IngredientName"
                         Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,16,0,6"
                           Style="{StaticResource FieldLabel}"
                           Text="Единица измерения" />
                <ComboBox ItemsSource="{Binding Units}"
                          AutomationProperties.AutomationId="IngredientUnit"
                          SelectedItem="{Binding SelectedUnit}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource UnitConverter}}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <StackPanel Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Margin="0,16,0,6"
                               Style="{StaticResource FieldLabel}"
                               Text="Начальный остаток" />
                    <TextBox AutomationProperties.AutomationId="IngredientInitialStock"
                             Text="{Binding InitialStockText, UpdateSourceTrigger=PropertyChanged}" />
                </StackPanel>

                <TextBlock Margin="0,16,0,6"
                           Style="{StaticResource FieldLabel}"
                           Text="Минимальный остаток" />
                <TextBox AutomationProperties.AutomationId="IngredientMinStock"
                         Text="{Binding MinStockText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,16,0,6"
                           Style="{StaticResource FieldLabel}"
                           Text="Закупочная цена, ₽ за единицу" />
                <TextBox AutomationProperties.AutomationId="IngredientPrice"
                         Text="{Binding PurchasePriceText, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Margin="0,12,0,0"
                           FontSize="11"
                           Foreground="{StaticResource WarningBrush}"
                           Text="Единицу измерения нельзя изменить, пока остаток не равен нулю."
                           TextWrapping="Wrap"
                           Visibility="{Binding ShowUnitHint, Converter={StaticResource BoolToVisibility}}" />

                <Border Margin="0,16,0,0"
                        Style="{StaticResource ErrorBanner}"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Text="{Binding ErrorMessage}"
                               FontSize="12"
                               Foreground="{StaticResource DangerBrush}"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Margin="0,22,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="110"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.AutomationId="IngredientCancel"
                    Content="Отмена"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButton}" />
            <Button Width="150"
                    Margin="10,0,0,0"
                    Command="{Binding SaveCommand}"
                    AutomationProperties.AutomationId="IngredientSave"
                    Content="Сохранить"
                    IsDefault="True"
                    Style="{StaticResource AccentButton}" />
        </StackPanel>
    </Grid>
</Window>
