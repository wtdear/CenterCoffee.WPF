<Window x:Class="CenterCoffee.WPF.Windows.RestoreConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding Title}"
        Width="560"
        Height="560"
        Background="{StaticResource CreamBrush}"
        FontFamily="{StaticResource AppFont}"
        Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="{Binding Title}"
                       FontSize="22"
                       FontWeight="SemiBold"
                       Foreground="{StaticResource TextBrush}" />
            <TextBlock Margin="0,5,0,0"
                       Text="{Binding Subtitle}"
                       FontSize="13"
                       Foreground="{StaticResource MutedBrush}"
                       TextWrapping="Wrap" />
        </StackPanel>

        <ScrollViewer Grid.Row="1"
                      Margin="0,20,0,0"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,4,0">
                <Border Padding="16,14"
                        Background="#FBF8F4"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="11">
                    <StackPanel>
                        <TextBlock Style="{StaticResource CaptionText}" Text="Файл резервной копии" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="{Binding FileName}"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,4,0,0"
                                   Text="{Binding FilePath}"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Style="{StaticResource CaptionText}" Text="Версия формата" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding SchemaVersionText}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock Style="{StaticResource CaptionText}" Text="Дата файла" />
                                <TextBlock Margin="0,3,0,0"
                                           Text="{Binding CreatedAtText}"
                                           FontSize="12"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Grid>

                        <TextBlock Margin="0,12,0,0"
                                   Style="{StaticResource CaptionText}"
                                   Text="Содержимое" />
                        <TextBlock Margin="0,3,0,0"
                                   Text="{Binding ContentsText}"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0"
                        Padding="14,12"
                        Background="{StaticResource WarningSoftBrush}"
                        BorderBrush="#EEDCB6"
                        BorderThickness="1"
                        CornerRadius="9"
                        Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                    <StackPanel>
                        <TextBlock Text="В копии есть замечания"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource WarningBrush}" />
                        <TextBlock Margin="0,5,0,0"
                                   Text="{Binding WarningText}"
                                   FontSize="12"
                                   Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Border Margin="0,14,0,0"
                        Padding="14,12"
                        Background="{StaticResource DangerSoftBrush}"
                        BorderBrush="#F0C9C5"
                        BorderThickness="1"
                        CornerRadius="9">
                    <StackPanel>
                        <TextBlock Text="Что произойдёт"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource DangerBrush}" />
                        <TextBlock Margin="0,5,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource TextBrush}"
                                   TextWrapping="Wrap"
                                   Text="Текущие складские позиции и история операций будут заменены данными из копии. Перед заменой программа сохранит страховочную копию текущего файла рядом с локальной базой, поэтому восстановление можно будет отменить вручную." />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Width="110"
                    Command="{Binding CancelCommand}"
                    AutomationProperties.AutomationId="RestoreCancel"
                    Content="Отмена"
                    IsCancel="True"
                    Style="{StaticResource SecondaryButton}" />
            <Button Width="190"
                    Margin="10,0,0,0"
                    Command="{Binding ConfirmCommand}"
                    AutomationProperties.AutomationId="RestoreConfirm"
                    Content="Восстановить данные"
                    IsDefault="True"
                    Style="{StaticResource AccentButton}" />
        </StackPanel>
    </Grid>
</Window>
