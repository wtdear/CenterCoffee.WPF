<UserControl x:Class="CenterCoffee.WPF.Views.WarehouseReportsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:CenterCoffee.WPF.ViewModels"
             xmlns:views="clr-namespace:CenterCoffee.WPF.Views"
             mc:Ignorable="d"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Вкладки отчётов -->
        <Border Grid.Row="0"
                Margin="0,0,0,12"
                Padding="8"
                Style="{StaticResource CardBorder}">
            <ListBox ItemsSource="{Binding Tabs}"
                     SelectedItem="{Binding SelectedTab, Mode=TwoWay}"
                     Style="{StaticResource ReportTabListStyle}"
                     AutomationProperties.AutomationId="ReportTabs">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type vm:WarehouseReportTabViewModel}">
                        <TextBlock Text="{Binding Title}"
                                   FontSize="13"
                                   FontWeight="SemiBold" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- Панель периода и действий -->
        <Border Grid.Row="1"
                Margin="0,0,0,12"
                Padding="16,12"
                Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           VerticalAlignment="Center"
                           Text="{Binding SelectedTab.Description}"
                           FontSize="12"
                           Foreground="{StaticResource MutedBrush}"
                           TextWrapping="Wrap" />

                <StackPanel Grid.Row="0"
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Margin="0,0,8,0"
                            Padding="14,8"
                            Command="{Binding RefreshCommand}"
                            AutomationProperties.AutomationId="ReportRefresh"
                            Content="Обновить"
                            Style="{StaticResource SecondaryButton}" />
                    <Button Padding="14,8"
                            Command="{Binding ExportCommand}"
                            AutomationProperties.AutomationId="ReportExport"
                            Content="Экспорт в CSV"
                            Style="{StaticResource AccentButton}" />
                </StackPanel>

                <!-- Период вынесен на отдельную строку: две даты не помещаются
                     рядом с описанием и кнопками на минимальной ширине окна. -->
                <StackPanel Grid.Row="1"
                            Grid.Column="0"
                            Grid.ColumnSpan="2"
                            Margin="0,10,0,0"
                            Orientation="Vertical"
                            Visibility="{Binding SelectedTab.HasPeriod, Converter={StaticResource BoolToVisibility}}">
                    <ItemsControl ItemsSource="{Binding SelectedTab.PeriodPresets}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Margin="0,0,6,6"
                                        Padding="10,4"
                                        AutomationProperties.Name="{Binding Title}"
                                        Command="{Binding}"
                                        Content="{Binding Title}"
                                        ToolTip="{Binding Title}">
                                    <Button.Style>
                                        <Style TargetType="{x:Type Button}"
                                               BasedOn="{StaticResource GhostButton}">
                                            <Setter Property="Background" Value="{StaticResource SurfaceBrush}" />
                                            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                            <Setter Property="FontSize" Value="12" />
                                            <Style.Triggers>
                                                <DataTrigger Value="True">
                                                    <DataTrigger.Binding>
                                                        <MultiBinding Converter="{StaticResource AllEqual}">
                                                            <Binding Path="Title" />
                                                            <Binding Path="DataContext.SelectedTab.ActivePeriodPresetTitle"
                                                                     RelativeSource="{RelativeSource AncestorType=UserControl}" />
                                                        </MultiBinding>
                                                    </DataTrigger.Binding>
                                                    <Setter Property="Background" Value="{StaticResource CaramelBrush}" />
                                                    <Setter Property="BorderBrush" Value="{StaticResource CaramelBrush}" />
                                                    <Setter Property="Foreground" Value="White" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Margin="0,2,0,0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Margin="0,0,6,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionText}"
                                   Text="Период:" />
                        <DatePicker Width="126"
                                    AutomationProperties.AutomationId="ReportPeriodFrom"
                                    SelectedDate="{Binding SelectedTab.PeriodFrom, Mode=TwoWay}" />
                        <TextBlock Margin="6,0,6,0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource CaptionText}"
                                   Text="—" />
                        <DatePicker Width="126"
                                    AutomationProperties.AutomationId="ReportPeriodTo"
                                    SelectedDate="{Binding SelectedTab.PeriodTo, Mode=TwoWay}" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Сообщение о результате -->
        <Border Grid.Row="2"
                Margin="0,0,0,12"
                Padding="14,11"
                BorderThickness="1"
                CornerRadius="9"
                Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
            <Border.Style>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                    <Setter Property="BorderBrush" Value="#CDE3D6" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                            <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                            <Setter Property="BorderBrush" Value="#F0C9C5" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding StatusMessage}"
                       FontSize="12"
                       TextWrapping="Wrap">
                <TextBlock.Style>
                    <Style TargetType="{x:Type TextBlock}">
                        <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- Содержимое выбранной вкладки -->
        <ContentControl Grid.Row="3"
                        Content="{Binding SelectedTab}"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch">
            <ContentControl.Resources>
                <DataTemplate DataType="{x:Type vm:StockReportTabViewModel}">
                    <views:StockReportTabView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:TurnoverReportTabViewModel}">
                    <views:TurnoverReportTabView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:DeficitReportTabViewModel}">
                    <views:DeficitReportTabView />
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:MovementsReportTabViewModel}">
                    <views:MovementsReportTabView />
                </DataTemplate>
            </ContentControl.Resources>
        </ContentControl>
    </Grid>
</UserControl>
