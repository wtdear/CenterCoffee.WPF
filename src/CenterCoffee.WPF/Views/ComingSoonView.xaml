<UserControl x:Class="CenterCoffee.WPF.Views.ComingSoonView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="{StaticResource AppFont}">
    <Border Padding="46" Style="{StaticResource CardBorder}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="640"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">

                <Border Width="84"
                        Height="84"
                        HorizontalAlignment="Center"
                        Background="{StaticResource CaramelSoftBrush}"
                        CornerRadius="24">
                    <TextBlock Text="{Binding Icon}"
                               FontSize="38"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center" />
                </Border>

                <Border Margin="0,20,0,0"
                        Background="{StaticResource WarningSoftBrush}"
                        Style="{StaticResource StatusPill}">
                    <TextBlock Text="В РАЗРАБОТКЕ"
                               Foreground="{StaticResource WarningBrush}"
                               FontSize="10"
                               FontWeight="Bold" />
                </Border>

                <TextBlock Margin="0,14,0,0"
                           Text="{Binding Title}"
                           FontSize="28"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextBrush}"
                           TextAlignment="Center" />

                <TextBlock Margin="0,10,0,0"
                           Text="{Binding Description}"
                           FontSize="14"
                           Foreground="{StaticResource MutedBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />

                <Border Margin="0,28,0,0"
                        Padding="24,20"
                        HorizontalAlignment="Stretch"
                        Background="#FBF8F4"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="13">
                    <StackPanel>
                        <TextBlock Text="Что появится в модуле"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />

                        <ItemsControl Margin="0,10,0,0"
                                      ItemsSource="{Binding PlannedFeatures}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="16" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="•"
                                                   Foreground="{StaticResource CaramelBrush}"
                                                   FontSize="16"
                                                   VerticalAlignment="Top" />
                                        <TextBlock Grid.Column="1"
                                                   Text="{Binding}"
                                                   FontSize="13"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Margin="0,22,0,0"
                           Text="Сейчас в системе работает модуль «Склад»: остатки, приход, списание и история операций."
                           FontSize="12"
                           Foreground="{StaticResource MutedBrush}"
                           TextAlignment="Center"
                           TextWrapping="Wrap" />
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
