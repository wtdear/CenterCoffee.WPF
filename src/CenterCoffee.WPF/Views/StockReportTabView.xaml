<UserControl x:Class="CenterCoffee.WPF.Views.StockReportTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,10,0"
                    Padding="14,12"
                    Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource KpiLabel}" Text="Позиций на складе" />
                    <TextBlock Style="{StaticResource KpiValue}"
                               Text="{Binding Report.Ingredients.Count}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Margin="0,0,10,0"
                    Padding="14,12"
                    Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource KpiLabel}" Text="Ниже минимума" />
                    <TextBlock Style="{StaticResource KpiValue}"
                               Foreground="{StaticResource WarningBrush}"
                               Text="{Binding Report.LowStockCount}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Margin="0,0,10,0"
                    Padding="14,12"
                    Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource KpiLabel}" Text="Нет в наличии" />
                    <TextBlock Style="{StaticResource KpiValue}"
                               Foreground="{StaticResource DangerBrush}"
                               Text="{Binding Report.OutOfStockCount}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3" Padding="14,12" Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource KpiLabel}" Text="Стоимость запасов" />
                    <TextBlock Style="{StaticResource KpiValue}"
                               Text="{Binding Report.TotalValue, Converter={StaticResource CurrencyConverter}}" />
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="1" Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid Margin="16,12,16,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Остатки на дату" />
                        <TextBlock Margin="8,2,0,0"
                                   Style="{StaticResource CaptionText}"
                                   Text="{Binding GeneratedAtText}" />
                    </StackPanel>
                    <TextBlock Grid.Column="1"
                               MaxWidth="360"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Style="{StaticResource CaptionText}"
                               Text="Стоимость — оценка по закупочной цене позиции, а не себестоимость."
                               TextAlignment="Right"
                               TextWrapping="Wrap" />
                </Grid>

                <DataGrid Grid.Row="1"
                          AutomationProperties.AutomationId="ReportStockGrid"
                          ItemsSource="{Binding Items}"
                          Style="{StaticResource AppDataGrid}"
                          ScrollViewer.HorizontalScrollBarVisibility="Auto">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="*"
                                                Header="Наименование"
                                                SortMemberPath="Name">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <Border Width="8"
                                                Height="8"
                                                Margin="0,0,10,0"
                                                Background="{Binding StatusBrush}"
                                                CornerRadius="4" />
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Width="54"
                                            Binding="{Binding UnitText}"
                                            Header="Ед."
                                            SortMemberPath="UnitText">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Center" />
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Width="80"
                                            Binding="{Binding StockText}"
                                            Header="Остаток"
                                            SortMemberPath="Stock">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="FontWeight" Value="SemiBold" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Width="80"
                                            Binding="{Binding MinStockText}"
                                            Header="Минимум">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTextColumn Width="104"
                                            Binding="{Binding StockValueText}"
                                            Header="Стоимость">
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="{x:Type TextBlock}">
                                    <Setter Property="HorizontalAlignment" Value="Right" />
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                        </DataGridTextColumn>

                        <DataGridTemplateColumn Width="118" Header="Статус">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding StatusBrush}"
                                            Style="{StaticResource StatusPill}">
                                        <TextBlock Text="{Binding StatusText}"
                                                   Foreground="White"
                                                   FontSize="11"
                                                   FontWeight="SemiBold" />
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>

                <Border Grid.Row="1"
                        Background="{StaticResource SurfaceBrush}"
                        Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock MaxWidth="360"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Text="{Binding EmptyText}"
                               FontSize="13"
                               Foreground="{StaticResource MutedBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
