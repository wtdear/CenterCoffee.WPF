<UserControl x:Class="CenterCoffee.WPF.Views.DataIntegrityView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="{StaticResource AppFont}">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,6,0">

            <!-- Состояние файла -->
            <Border Padding="20,18" Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Border Width="44"
                            Height="44"
                            Background="{Binding LevelBrush}"
                            CornerRadius="22"
                            VerticalAlignment="Top">
                        <TextBlock Text="✓"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>

                    <StackPanel Grid.Column="1" Margin="16,0,16,0">
                        <TextBlock Text="{Binding LevelTitle}"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Margin="0,5,0,0"
                                   Text="{Binding LevelDescription}"
                                   FontSize="13"
                                   Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            VerticalAlignment="Top"
                            Command="{Binding RefreshCommand}"
                            AutomationProperties.AutomationId="IntegrityRefresh"
                            Content="Проверить снова"
                            Style="{StaticResource SecondaryButton}" />
                </Grid>
            </Border>

            <!-- Сведения о файле -->
            <Border Margin="0,16,0,0"
                    Padding="20,18"
                    Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Файл данных" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Margin="0,0,0,8" Style="{StaticResource CaptionText}" Text="Путь" />
                        <TextBlock Grid.Row="0"
                                   Grid.Column="1"
                                   Margin="0,0,0,8"
                                   Text="{Binding FilePathText}"
                                   FontSize="12"
                                   TextWrapping="Wrap" />

                        <TextBlock Grid.Row="1" Margin="0,0,0,8" Style="{StaticResource CaptionText}" Text="Версия формата" />
                        <TextBlock Grid.Row="1"
                                   Grid.Column="1"
                                   Margin="0,0,0,8"
                                   Text="{Binding SchemaVersionText}"
                                   FontSize="12"
                                   FontWeight="SemiBold" />

                        <TextBlock Grid.Row="2" Margin="0,0,0,8" Style="{StaticResource CaptionText}" Text="Изменён" />
                        <TextBlock Grid.Row="2"
                                   Grid.Column="1"
                                   Margin="0,0,0,8"
                                   Text="{Binding LastWriteText}"
                                   FontSize="12" />

                        <TextBlock Grid.Row="3" Style="{StaticResource CaptionText}" Text="Содержимое" />
                        <TextBlock Grid.Row="3"
                                   Grid.Column="1"
                                   Text="{Binding ContentsText}"
                                   FontSize="12" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Замечания -->
            <Border Margin="0,16,0,0"
                    Padding="20,18"
                    Style="{StaticResource CardBorder}"
                    Visibility="{Binding HasIssues, Converter={StaticResource BoolToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Замечания проверки" />
                    <TextBlock Margin="0,5,0,0"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               Text="Замечания не исправляются автоматически: сначала решите, какие данные верны."
                               TextWrapping="Wrap" />

                    <ItemsControl Margin="0,12,0,0" ItemsSource="{Binding Issues}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,8"
                                        Padding="12,10"
                                        Background="#FBF8F4"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1"
                                        CornerRadius="9">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Margin="0,1,10,0"
                                                Padding="7,2"
                                                Background="{StaticResource WarningSoftBrush}"
                                                CornerRadius="6"
                                                VerticalAlignment="Top">
                                            <TextBlock Text="{Binding SeverityText}"
                                                       FontSize="10"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource WarningBrush}" />
                                        </Border>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="{Binding Title}"
                                                       FontSize="12"
                                                       FontWeight="SemiBold" />
                                            <TextBlock Margin="0,3,0,0"
                                                       Text="{Binding Details}"
                                                       FontSize="12"
                                                       Foreground="{StaticResource TextBrush}"
                                                       TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <!-- Резервное копирование -->
            <Grid Margin="0,16,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,8,0"
                        Padding="20,18"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Создать резервную копию" />
                        <TextBlock Margin="0,5,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="Копия сохраняется отдельным файлом .json с датой в имени. Копия проверяется сразу после записи."
                                   TextWrapping="Wrap" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource WarningBrush}"
                                   Text="{Binding BackupBlockReason}"
                                   TextWrapping="Wrap"
                                   Visibility="{Binding CanCreateBackupNow, Converter={StaticResource InverseBoolToVisibility}}" />
                        <Button Margin="0,16,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding CreateBackupCommand}"
                                AutomationProperties.AutomationId="IntegrityBackup"
                                Content="💾  Создать копию"
                                Style="{StaticResource AccentButton}" />
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Margin="8,0,0,0"
                        Padding="20,18"
                        Style="{StaticResource CardBorder}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Восстановить из копии" />
                        <TextBlock Margin="0,5,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource MutedBrush}"
                                   Text="Файл копии сначала проверяется. Перед заменой данных программа сохранит страховочную копию текущего файла."
                                   TextWrapping="Wrap" />
                        <Button Margin="0,16,0,0"
                                HorizontalAlignment="Left"
                                Command="{Binding RestoreCommand}"
                                AutomationProperties.AutomationId="IntegrityRestore"
                                Content="Восстановить данные"
                                Style="{StaticResource SecondaryButton}" />
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Сообщение о результате действий -->
            <Border Margin="0,16,0,0"
                    Padding="14,11"
                    CornerRadius="9"
                    BorderThickness="1"
                    Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                <Border.Style>
                    <Style TargetType="{x:Type Border}">
                        <Setter Property="Background" Value="{StaticResource SuccessSoftBrush}" />
                        <Setter Property="BorderBrush" Value="#CDE3D6" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                <Setter Property="Background" Value="{StaticResource DangerSoftBrush}" />
                                <Setter Property="BorderBrush" Value="#F0C9C5" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding StatusMessage}"
                           FontSize="12"
                           TextWrapping="Wrap">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusIsError}" Value="True">
                                    <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
