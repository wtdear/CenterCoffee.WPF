<UserControl x:Class="CenterCoffee.WPF.Views.WarehouseView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             FontFamily="{StaticResource AppFont}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Показатели склада -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,12,0"
                    Padding="20,16"
                    Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource KpiLabel}" Text="Позиций на складе" />
                    <TextBlock Style="{StaticResource KpiValue}"
                               Text="{Binding Summary.PositionsCount}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Margin="0,0,12,0"
                    Padding="20,16"
                    Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource KpiLabel}" Text="Ниже минимума" />
                    <TextBlock Style="{StaticResource KpiValue}"
                               Foreground="{StaticResource WarningBrush}"
                               Text="{Binding Summary.LowStockCount}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="2"
                    Margin="0,0,12,0"
                    Padding="20,16"
                    Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource KpiLabel}" Text="Нет в наличии" />
                    <TextBlock Style="{StaticResource KpiValue}"
                               Foreground="{StaticResource DangerBrush}"
                               Text="{Binding Summary.OutOfStockCount}" />
                </StackPanel>
            </Border>

            <Border Grid.Column="3"
                    Padding="20,16"
                    Style="{StaticResource CardBorder}">
                <StackPanel>
                    <TextBlock Style="{StaticResource KpiLabel}" Text="Стоимость запасов" />
                    <TextBlock Style="{StaticResource KpiValue}"
                               FontSize="26"
                               Text="{Binding Summary.StockValue, Converter={StaticResource CurrencyConverter}}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- Панель действий -->
        <Border Grid.Row="1"
                Margin="0,0,0,16"
                Padding="14,12"
                Style="{StaticResource CardBorder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Grid Width="300">
                        <TextBox Style="{StaticResource SearchTextBox}"
                                 AutomationProperties.AutomationId="WarehouseSearch"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Поиск по названию позиции" />
                        <TextBlock Margin="13,0,0,0"
                                   Text="🔍"
                                   FontSize="14"
                                   Opacity="0.55"
                                   IsHitTestVisible="False"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <CheckBox Margin="16,0,0,0"
                              AutomationProperties.AutomationId="WarehouseLowStockFilter"
                              Content="Только ниже минимума"
                              IsChecked="{Binding LowStockOnly}"
                              VerticalAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Margin="0,0,8,0"
                            Command="{Binding RefreshCommand}"
                            AutomationProperties.AutomationId="WarehouseRefresh"
                            Content="Обновить"
                            Style="{StaticResource SecondaryButton}" />
                    <Button Command="{Binding AddIngredientCommand}"
                            AutomationProperties.AutomationId="WarehouseAddButton"
                            Content="+  Добавить позицию"
                            Style="{StaticResource AccentButton}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Таблица и карточка позиции -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="320" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0"
                    Margin="0,0,16,0"
                    Style="{StaticResource CardBorder}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="20,16,20,10">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Складские позиции" />
                            <TextBlock Margin="8,2,0,0"
                                       Style="{StaticResource CaptionText}"
                                       Text="{Binding Ingredients.Count, StringFormat={}{0} поз.}" />
                        </StackPanel>
                    </Grid>

                    <DataGrid Grid.Row="1"
                              AutomationProperties.AutomationId="WarehouseGrid"
                              ItemsSource="{Binding Ingredients}"
                              SelectedItem="{Binding SelectedIngredient, Mode=TwoWay}"
                              Style="{StaticResource AppDataGrid}"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="*"
                                                    Header="Наименование"
                                                    SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Border Width="8"
                                                    Height="8"
                                                    Margin="0,0,10,0"
                                                    Background="{Binding StatusBrush}"
                                                    CornerRadius="4" />
                                            <TextBlock Text="{Binding Name}"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextBrush}"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <DataGridTextColumn Width="55"
                                                Binding="{Binding UnitText}"
                                                Header="Ед."
                                                SortMemberPath="UnitText">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Center" />
                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Width="80"
                                                Binding="{Binding StockText}"
                                                Header="Остаток"
                                                SortMemberPath="Stock">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Width="80"
                                                Binding="{Binding MinStockText}"
                                                Header="Минимум"
                                                SortMemberPath="MinStockText">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                        <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTextColumn Width="110"
                                                Binding="{Binding StockValueText}"
                                                Header="Стоимость"
                                                SortMemberPath="StockValueText">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="{x:Type TextBlock}">
                                        <Setter Property="HorizontalAlignment" Value="Right" />
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>

                            <DataGridTemplateColumn Width="135"
                                                    Header="Статус"
                                                    SortMemberPath="StatusText">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding StatusBrush}"
                                                Style="{StaticResource StatusPill}">
                                            <TextBlock Text="{Binding StatusText}"
                                                       Foreground="White"
                                                       FontSize="11"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Пустое состояние -->
                    <Border Grid.Row="1"
                            Margin="0,42,0,0"
                            Background="{StaticResource SurfaceBrush}"
                            Visibility="{Binding IsEmpty, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel MaxWidth="360"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                            <TextBlock Text="📦"
                                       FontSize="44"
                                       HorizontalAlignment="Center" />
                            <TextBlock Margin="0,14,0,0"
                                       Text="{Binding EmptyStateText}"
                                       FontSize="14"
                                       Foreground="{StaticResource MutedBrush}"
                                       TextAlignment="Center"
                                       TextWrapping="Wrap" />
                            <Button Margin="0,18,0,0"
                                    HorizontalAlignment="Center"
                                    Command="{Binding AddIngredientCommand}"
                                    AutomationProperties.AutomationId="WarehouseEmptyAdd"
                                    Content="+  Добавить позицию"
                                    Style="{StaticResource AccentButton}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <Border Grid.Column="1"
                    Padding="20"
                    Style="{StaticResource CardBorder}">
                <Grid>
                    <TextBlock Text="Выберите позицию, чтобы увидеть остатки и историю операций."
                               MaxWidth="240"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontSize="13"
                               Foreground="{StaticResource MutedBrush}"
                               TextAlignment="Center"
                               TextWrapping="Wrap"
                               Visibility="{Binding HasSelection, Converter={StaticResource InverseBoolToVisibility}}" />

                    <Grid Visibility="{Binding HasSelection, Converter={StaticResource BoolToVisibility}}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Style="{StaticResource CaptionText}"
                                       Text="ВЫБРАННАЯ ПОЗИЦИЯ" />
                            <TextBlock Margin="0,6,0,0"
                                       Text="{Binding SelectedIngredient.Name}"
                                       FontSize="19"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource TextBrush}"
                                       TextWrapping="Wrap" />

                            <Border Margin="0,8,0,0"
                                    Background="{Binding SelectedIngredient.StatusBrush}"
                                    Style="{StaticResource StatusPill}">
                                <TextBlock Text="{Binding SelectedIngredient.StatusText}"
                                           Foreground="White"
                                           FontSize="11"
                                           FontWeight="SemiBold" />
                            </Border>

                            <Grid Margin="0,16,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource KpiLabel}" Text="Остаток" />
                                    <StackPanel Margin="0,4,0,0" Orientation="Horizontal">
                                        <TextBlock Text="{Binding SelectedIngredient.StockText}"
                                                   FontSize="28"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}" />
                                        <TextBlock Margin="5,8,0,0"
                                                   Text="{Binding SelectedIngredient.UnitText}"
                                                   FontSize="13"
                                                   Foreground="{StaticResource MutedBrush}" />
                                    </StackPanel>
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0"
                                           Margin="0,0,0,7"
                                           Style="{StaticResource CaptionText}"
                                           Text="Минимальный остаток" />
                                <TextBlock Grid.Row="0"
                                           Grid.Column="1"
                                           Margin="0,0,0,7"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="{Binding SelectedIngredient.MinStockText}" />

                                <TextBlock Grid.Row="1"
                                           Margin="0,0,0,7"
                                           Style="{StaticResource CaptionText}"
                                           Text="Закупочная цена" />
                                <TextBlock Grid.Row="1"
                                           Grid.Column="1"
                                           Margin="0,0,0,7"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="{Binding SelectedIngredient.PurchasePriceText}" />

                                <TextBlock Grid.Row="2"
                                           Margin="0,0,0,7"
                                           Style="{StaticResource CaptionText}"
                                           Text="Стоимость запаса" />
                                <TextBlock Grid.Row="2"
                                           Grid.Column="1"
                                           Margin="0,0,0,7"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="{Binding SelectedIngredient.StockValueText}" />

                                <TextBlock Grid.Row="3"
                                           Style="{StaticResource CaptionText}"
                                           Text="Единица измерения" />
                                <TextBlock Grid.Row="3"
                                           Grid.Column="1"
                                           FontSize="12"
                                           FontWeight="SemiBold"
                                           Text="{Binding SelectedIngredient.UnitText}" />
                            </Grid>

                            <Grid Margin="0,18,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Grid.Column="0"
                                        Margin="0,0,5,0"
                                        Command="{Binding ReceiveStockCommand}"
                                        AutomationProperties.AutomationId="WarehouseReceive"
                                        Content="+  Приход"
                                        Style="{StaticResource AccentButton}" />
                                <Button Grid.Column="1"
                                        Margin="5,0,0,0"
                                        Command="{Binding WriteOffStockCommand}"
                                        AutomationProperties.AutomationId="WarehouseWriteOff"
                                        Content="−  Списание"
                                        Style="{StaticResource DangerButton}" />
                            </Grid>

                            <Button Margin="0,7,0,0"
                                    HorizontalAlignment="Left"
                                    Padding="0,8"
                                    Command="{Binding EditIngredientCommand}"
                                    AutomationProperties.AutomationId="WarehouseEdit"
                                    Content="Изменить параметры"
                                    Style="{StaticResource GhostButton}" />
                        </StackPanel>

                        <Border Grid.Row="1"
                                Margin="0,14,0,0"
                                Padding="0,14,0,8"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,1,0,0">
                            <Grid>
                                <TextBlock FontSize="14"
                                           FontWeight="SemiBold"
                                           Text="{Binding HistoryCaption}" />
                                <CheckBox HorizontalAlignment="Right"
                                          Content="Все"
                                          IsChecked="{Binding ShowAllMovements}" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Movements}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Padding="0,10"
                                                    BorderBrush="#F1EAE2"
                                                    BorderThickness="0,0,0,1">
                                                <StackPanel>
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{Binding TypeText}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="{x:Type TextBlock}">
                                                                    <Setter Property="Foreground" Value="{StaticResource MutedBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsReceipt}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsWriteOff}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                        <TextBlock Grid.Column="1"
                                                                   Text="{Binding AmountText}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="{x:Type TextBlock}">
                                                                    <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsReceipt}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource SuccessBrush}" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding IsWriteOff}" Value="True">
                                                                            <Setter Property="Foreground" Value="{StaticResource DangerBrush}" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Grid>

                                                    <TextBlock Margin="0,3,0,0"
                                                               Style="{StaticResource CaptionText}"
                                                               Text="{Binding CreatedAtText}" />
                                                    <TextBlock Margin="0,3,0,0"
                                                               FontSize="12"
                                                               Foreground="{StaticResource TextBrush}"
                                                               Text="{Binding ReasonText}"
                                                               TextWrapping="Wrap" />
                                                    <TextBlock Margin="0,3,0,0"
                                                               Style="{StaticResource CaptionText}"
                                                               Text="{Binding StockAfterText}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>

                            <TextBlock Text="Операций пока нет"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="12"
                                       Foreground="{StaticResource MutedBrush}"
                                       Visibility="{Binding HasMovements, Converter={StaticResource InverseBoolToVisibility}}" />
                        </Grid>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
